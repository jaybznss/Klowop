# Copy this file to .env and fill in your Plaid credentials (dashboard.plaid.com)
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_sandbox_or_production_secret
# sandbox | development | production
PLAID_ENV=sandbox
# Comma-separated Plaid country codes for your banks
PLAID_COUNTRY_CODES=US
PORT=8484

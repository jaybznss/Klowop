# Copy to .env and fill in. Never commit .env.

# --- Server ---
PORT=8484
# Long random string used to sign our own session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_a_long_random_string

# --- Anthropic (the backend holds this; the app never sees it) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional hard ceiling per assistant request (tokens)
ASSISTANT_MAX_TOKENS=16000

# --- Apple ---
# Your app's bundle id — Sign in with Apple identity tokens are validated against this audience.
APPLE_BUNDLE_ID=com.jaybznss.Klowop

# --- Plaid (dashboard.plaid.com) ---
PLAID_CLIENT_ID=your_client_id
PLAID_SECRET=your_secret
# sandbox | production
PLAID_ENV=sandbox
PLAID_COUNTRY_CODES=US,CA

# --- Subscription gating ---
# While true, the AI + Plaid endpoints work without an active subscription (dev only).
# Set to false in production so only subscribers get premium features.
ALLOW_FREE_PREMIUM=true

# --- Persistence ---
# Point at a persistent volume so accounts survive redeploys.
# On Railway: add a Volume mounted at /data, then set:
#   DATABASE_PATH=/data/klowop.db
DATABASE_PATH=

# --- StoreKit verification (production hardening) ---
# Set to true in production to validate the full Apple certificate chain.
# Leave false for local Xcode StoreKit testing (those transactions aren't
# signed by Apple and would fail strict validation).
STOREKIT_STRICT=false
# Sandbox | Production  (Sandbox covers TestFlight + dev)
APPLE_ENVIRONMENT=Sandbox
# Your app's numeric App Store ID (required for Production strict checks)
APPLE_APP_APPLE_ID=
# Apple Root CA - G3, base64-encoded DER. Download AppleRootCA-G3.cer from
# https://www.apple.com/certificateauthority/ then:
#   base64 -i AppleRootCA-G3.cer | tr -d '\n'
# (Alternatively drop the .cer file at server/certs/AppleRootCA-G3.cer)
APPLE_ROOT_CA_BASE64=
